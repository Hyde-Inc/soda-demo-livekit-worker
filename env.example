# PostgreSQL
POSTGRES_USER=app
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=app_db

# Redis
REDIS_USER=app
REDIS_PASSWORD=your_redis_password

# Foundry Authentication (required for uv sync during build)
FOUNDRY_TOKEN=your_foundry_token
UV_INDEX_FOUNDRY_MAIN_USERNAME=user
UV_INDEX_FOUNDRY_MAIN_PASSWORD=${FOUNDRY_TOKEN}
UV_INDEX_FOUNDRY_SDK_BUNDLE_USERNAME=user
UV_INDEX_FOUNDRY_SDK_BUNDLE_PASSWORD=${FOUNDRY_TOKEN}

# Foundry SDK (runtime)
FOUNDRY_HOSTNAME=hyde.palantirfoundry.com

# LiveKit
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
# Worker registration name (must match dispatch / SIP config if using explicit agent dispatch)
LIVEKIT_AGENT_NAME=tatachemicals-voice-agent
SIP_OUTBOUND_TRUNK_ID=your_sip_trunk_id

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key

# Cartesia
CARTESIA_API_KEY=your_cartesia_api_key

# AWS (optional - for aws plugin)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# Egress Recording (S3 bucket for call recordings)
EGRESS_S3_BUCKET=your-recordings-bucket

# Sarvam (optional - for sarvam plugin)
SARVAM_API_KEY=

# Browserbase (for browser automation / Ariba form fill)
BROWSERBASE_API_KEY=your_browserbase_api_key
BROWSERBASE_PROJECT_ID=your_browserbase_project_id

# Ariba Web (login page and credentials for Playwright form fill)
ARIBA_WEB_URL=https://your-ariba-realm.s4.ariba.com
ARIBA_WEB_EMAIL=your_ariba_web_login_email
ARIBA_WEB_PASSWORD=your_ariba_web_password
